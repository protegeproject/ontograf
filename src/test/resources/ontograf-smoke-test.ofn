Prefix(:=<urn:ontograf:smoke#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<urn:ontograf:smoke>
 Declaration(Class(:Person))
 Declaration(Class(:Animal))
 Declaration(Class(:Pet))
 Declaration(Class(:Dog))
 Declaration(Class(:PetOwner))
 Declaration(ObjectProperty(:owns))
 Declaration(NamedIndividual(:Alice))
 Declaration(NamedIndividual(:Rex))
 SubClassOf(:Dog :Animal)
 SubClassOf(:Dog ObjectSomeValuesFrom(ObjectInverseOf(:owns) :Person))
 EquivalentClasses(:Pet ObjectIntersectionOf(:Animal ObjectSomeValuesFrom(ObjectInverseOf(:owns) :Person)))
 EquivalentClasses(:PetOwner ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:owns :Pet)))
 ObjectPropertyDomain(:owns :Person)
 ObjectPropertyRange(:owns :Pet)
 ClassAssertion(:Person :Alice)
 ClassAssertion(:Dog :Rex)
 ObjectPropertyAssertion(:owns :Alice :Rex)
 AnnotationAssertion(rdfs:label :Person "Person")
 AnnotationAssertion(rdfs:label :Pet "Pet")
 AnnotationAssertion(rdfs:label :Dog "Dog")
 AnnotationAssertion(rdfs:label :PetOwner "Pet owner")
 AnnotationAssertion(rdfs:label :Alice "Alice")
 AnnotationAssertion(rdfs:label :Rex "Rex")
)
