Prefix(:=<urn:ontograf:test#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<urn:ontograf:test>
 Declaration(Class(:Person)) Declaration(Class(:Employee)) Declaration(Class(:Organisation)) Declaration(Class(:Isolated))
 Declaration(ObjectProperty(:worksFor)) Declaration(ObjectProperty(:otherProperty))
 Declaration(NamedIndividual(:alice)) Declaration(NamedIndividual(:acme))
 AnnotationAssertion(rdfs:label :worksFor "works for"@en)
 AnnotationAssertion(rdfs:label :otherProperty "works for"@en)
 SubClassOf(:Employee :Person)
 SubClassOf(Annotation(rdfs:label "employment"@en) :Person ObjectSomeValuesFrom(:worksFor :Organisation))
 SubClassOf(:Person ObjectAllValuesFrom(:worksFor :Organisation))
 EquivalentClasses(:Employee ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:worksFor :Organisation)))
 SubClassOf(:Person ObjectMinCardinality(2 :worksFor :Organisation))
 SubClassOf(:Person ObjectHasValue(:worksFor :acme))
 ClassAssertion(:Person :alice)
 ObjectPropertyAssertion(:worksFor :alice :acme)
 ObjectPropertyAssertion(:otherProperty :alice :acme)
 ObjectPropertyAssertion(:worksFor :alice :alice)
 ObjectPropertyAssertion(:worksFor :alice _:anonymous)
 ObjectPropertyDomain(:worksFor :Person)
 ObjectPropertyRange(:worksFor :Organisation)
)
